    <path android:fillColor="#FFFFFFFF" android:pathData="M2,3h20v2.4H2Z" />
    <!-- left leg (long) -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M5,5.4h2.4v12.4H5Z" />
    <!-- right leg (short) -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M15,5.4h2.4v9H15Z" />
